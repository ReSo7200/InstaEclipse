<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="132dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
    app:cardCornerRadius="22dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <!-- Avatar: monogram fallback (colored circle + initial) with the GitHub profile photo
             overlaid on top when it loads. -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="10dp"
            android:padding="3dp"
            android:background="@drawable/bg_avatar_ring">

            <TextView
                android:id="@+id/contributor_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                tools:text="R" />

            <ImageView
                android:id="@+id/contributor_avatar_img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="@null" />
        </FrameLayout>

        <!-- Contributor Name -->
        <TextView
            android:id="@+id/contributor_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/contributor_name"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="10dp"
            tools:text="ReSo7200" />

        <!-- Social Buttons Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageButton
                android:id="@+id/github_button"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_social_chip"
                android:contentDescription="GitHub"
                android:src="@drawable/ic_github_logo"
                android:scaleType="fitCenter"
                android:padding="7dp"
                android:visibility="gone"
                android:layoutDirection="ltr"
                app:tint="?attr/colorOnSurface"
                tools:ignore="HardcodedText" />

            <ImageButton
                android:id="@+id/linkedin_button"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_social_chip"
                android:contentDescription="LinkedIn"
                android:src="@drawable/ic_linkedin_logo"
                android:scaleType="fitCenter"
                android:padding="7dp"
                android:visibility="gone"
                android:layoutDirection="ltr"
                app:tint="?attr/colorOnSurface"
                tools:ignore="HardcodedText" />

            <ImageButton
                android:id="@+id/telegram_button"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_social_chip"
                android:contentDescription="Telegram"
                android:src="@drawable/ic_telegram_logo"
                android:scaleType="fitCenter"
                android:padding="7dp"
                android:visibility="gone"
                android:layoutDirection="ltr"
                app:tint="?attr/colorOnSurface"
                tools:ignore="HardcodedText" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
